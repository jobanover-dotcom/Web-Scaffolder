{
  "name": "web-scaffolder",
  "version": "1.0.0",
  "description": "Stack-aware web application scaffolding CLI",
  "main": "index.js",
  "type": "module",
  "bin": {
    "web-scaffolder": "./index.js"
  },
  "files": [
    "index.js",
    "lib",
    "compatibility",
    "playbooks",
    "ci",
    "templates",
    "scripts",
    "docs/ARCHITECTURE.md",
    "docs/CONTENT_MODEL.md",
    "docs/DEPENDENCY_MAINTENANCE.md",
    "docs/STACK_EXTENSIONS.md",
    "docs/ROADMAP.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "doctor": "node index.js doctor",
    "stack:new": "node scripts/create-stack.mjs",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.mjs",
    "matrix:smoke": "node scripts/compatibility-matrix.mjs --scope=smoke",
    "matrix:full": "node scripts/compatibility-matrix.mjs --scope=full",
    "verify:generated": "node scripts/verify-generated.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "fs-extra": "11.4.0",
    "inquirer": "9.3.8",
    "ora": "7.0.1"
  },
  "devDependencies": {
    "vitest": "2.1.9"
  }
}
